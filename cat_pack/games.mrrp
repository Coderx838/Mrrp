mrrp
# games.mrrp - cat_pack stdlib: dice + coins (uses python borrow!)
# use: adopt games
# then: meow dice() / meow coin()
borrow random

trick dice() {
  fetch random.randint(1, 6)
}

trick dice20() {
  fetch random.randint(1, 20)
}

trick coin() {
  paw n = random.randint(0, 1)
  purr n == 1 {
    fetch "heads"
  }
  hiss {
    fetch "tails"
  }
}
